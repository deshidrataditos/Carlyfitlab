# Keep false until the owner approves final catalog/prices and sandbox checks pass.
PAYMENTS_ENABLED=false
CATALOG_CONFIRMED=false
MERCADOPAGO_MODE=test
SITE_URL=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_COLLECTOR_ID=

# Only the project URL and publishable key. Never use service_role here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Enable after applying the migration and configuring Google and callback URLs.
GOOGLE_AUTH_ENABLED=false

# Server-side Cloudflare AI binding only; no API key in the browser.
# Keep disabled until D1 migration 0004 is applied and Workers Free is verified.
ASSISTANT_ENABLED=false

# Transactional welcome email. Set the launch cutoff once when activating.
# Store the domain-scoped sending key as an encrypted Cloudflare secret.
WELCOME_EMAIL_ENABLED=false
WELCOME_EMAIL_START_AT=
RESEND_API_KEY=
