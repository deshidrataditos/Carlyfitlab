{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "carlyfit-lab-testing",
  "main": "workers/store-worker.ts",
  "triggers": { "crons": ["*/5 * * * *"] },
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "carlyfit-lab-testing-orders",
      "database_id": "baf321c0-1688-461c-9f6f-8d14327048ff",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "SITE_URL": "https://carlyfit-lab-testing.carlyfitlab.workers.dev",
    "PAYMENTS_ENABLED": "true",
    "CATALOG_CONFIRMED": "true",
    "MERCADOPAGO_MODE": "test",
    "GOOGLE_AUTH_ENABLED": "false",
    "SITE_TESTING": "true",
    "ASSISTANT_ENABLED": "false",
    "WELCOME_EMAIL_ENABLED": "false",
    "WELCOME_EMAIL_START_AT": "",
    "PLAN_EMAIL_ENABLED": "false",
    "PLAN_EMAIL_START_AT": "",
    "MATERIAL_EMAIL_ENABLED": "false",
    "MATERIAL_EMAIL_START_AT": ""
  }
}
