{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "carlyfit-lab",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "carlyfitlab.com", "custom_domain": true },
    { "pattern": "www.carlyfitlab.com", "custom_domain": true }
  ],
  "keep_vars": true,
  "ai": { "binding": "AI" },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "carlyfit-lab-orders",
      "database_id": "e8b3b720-2091-4511-832f-9cf76d83cd8c",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "SITE_URL": "https://carlyfitlab.com",
    "PAYMENTS_ENABLED": "true",
    "CATALOG_CONFIRMED": "true",
    "MERCADOPAGO_MODE": "live",
    "GOOGLE_AUTH_ENABLED": "true",
    "ASSISTANT_ENABLED": "true"
  }
}
